diff --git a/app/src/main/java/javax/microedition/shell/TreoOnlineService.java b/app/src/main/java/javax/microedition/shell/TreoOnlineService.java
new file mode 100644
index 0000000..d0a5052
--- /dev/null
+++ b/app/src/main/java/javax/microedition/shell/TreoOnlineService.java
@@ -0,0 +1,171 @@
+package javax.microedition.shell;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.os.Build;
+import android.os.IBinder;
+import android.os.PowerManager;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+import androidx.core.app.NotificationCompat;
+
+import ru.playsoftware.j2meloader.R;
+
+/** Keeps the J2ME process alive while the user intentionally backgrounds a game. */
+public final class TreoOnlineService extends Service {
+    private static final String TAG = "TreoOnlineService";
+    private static final String CHANNEL_ID = "j2me_treo_online";
+    private static final int NOTIFICATION_ID = 48116;
+    private static final String ACTION_START = "javax.microedition.shell.action.TREO_START";
+    private static final String ACTION_STOP = "javax.microedition.shell.action.TREO_STOP";
+
+    // MicroActivity and this service are both declared in the :midlet process.
+    private static volatile boolean enabled;
+    private PowerManager.WakeLock wakeLock;
+
+    public static boolean isEnabled() {
+        return enabled;
+    }
+
+    public static boolean enable(Context context) {
+        enabled = true; // Publish before Android can deliver ON_STOP.
+        Intent intent = new Intent(context, TreoOnlineService.class).setAction(ACTION_START);
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                context.startForegroundService(intent);
+            } else {
+                context.startService(intent);
+            }
+            return true;
+        } catch (RuntimeException e) {
+            enabled = false;
+            Log.e(TAG, "Unable to start Treo service", e);
+            return false;
+        }
+    }
+
+    public static void disable(Context context) {
+        // Clear synchronously so a following ON_STOP pauses the MIDlet normally.
+        enabled = false;
+        try {
+            context.startService(new Intent(context, TreoOnlineService.class).setAction(ACTION_STOP));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Unable to request Treo service stop", e);
+            context.stopService(new Intent(context, TreoOnlineService.class));
+        }
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        createNotificationChannel();
+    }
+
+    @Override
+    public int onStartCommand(@Nullable Intent intent, int flags, int startId) {
+        if (intent != null && ACTION_STOP.equals(intent.getAction())) {
+            enabled = false;
+            releaseWakeLock();
+            stopForeground(true);
+            stopSelf(startId);
+            return START_NOT_STICKY;
+        }
+
+        enabled = true;
+        try {
+            Notification notification = buildNotification();
+            if (Build.VERSION.SDK_INT >= 34) {
+                startForeground(NOTIFICATION_ID, notification,
+                        ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
+            } else {
+                startForeground(NOTIFICATION_ID, notification);
+            }
+            acquireWakeLock();
+            return START_STICKY;
+        } catch (RuntimeException e) {
+            enabled = false;
+            releaseWakeLock();
+            Log.e(TAG, "Unable to enter foreground Treo mode", e);
+            stopForeground(true);
+            stopSelf(startId);
+            return START_NOT_STICKY;
+        }
+    }
+
+    private void createNotificationChannel() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            NotificationManager manager = getSystemService(NotificationManager.class);
+            if (manager != null && manager.getNotificationChannel(CHANNEL_ID) == null) {
+                manager.createNotificationChannel(new NotificationChannel(
+                        CHANNEL_ID, getString(R.string.treo_channel_name),
+                        NotificationManager.IMPORTANCE_LOW));
+            }
+        }
+    }
+
+    private Notification buildNotification() {
+        Intent openIntent = new Intent(this, MicroActivity.class)
+                .addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        int pendingFlags = PendingIntent.FLAG_UPDATE_CURRENT;
+        if (Build.VERSION.SDK_INT >= 23) pendingFlags |= PendingIntent.FLAG_IMMUTABLE;
+        PendingIntent contentIntent = PendingIntent.getActivity(this, 48116, openIntent, pendingFlags);
+        return new NotificationCompat.Builder(this, CHANNEL_ID)
+                .setSmallIcon(android.R.drawable.ic_media_play)
+                .setContentTitle(getString(R.string.treo_notification_title))
+                .setContentText(getString(R.string.treo_notification_text))
+                .setContentIntent(contentIntent)
+                .setCategory(NotificationCompat.CATEGORY_SERVICE)
+                .setPriority(NotificationCompat.PRIORITY_LOW)
+                .setOngoing(true)
+                .setOnlyAlertOnce(true)
+                .build();
+    }
+
+    private void acquireWakeLock() {
+        if (wakeLock != null && wakeLock.isHeld()) return;
+        PowerManager powerManager = (PowerManager) getSystemService(POWER_SERVICE);
+        if (powerManager == null) return;
+        wakeLock = powerManager.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK,
+                getPackageName() + ":TreoOnline");
+        wakeLock.setReferenceCounted(false);
+        wakeLock.acquire();
+    }
+
+    private void releaseWakeLock() {
+        PowerManager.WakeLock lock = wakeLock;
+        wakeLock = null;
+        if (lock != null) {
+            try {
+                if (lock.isHeld()) lock.release();
+            } catch (RuntimeException e) {
+                Log.w(TAG, "WakeLock release failed", e);
+            }
+        }
+    }
+
+    @Override
+    public void onTaskRemoved(Intent rootIntent) {
+        // Deliberately keep the foreground service after the task is removed.
+        super.onTaskRemoved(rootIntent);
+    }
+
+    @Override
+    public void onDestroy() {
+        enabled = false;
+        releaseWakeLock();
+        super.onDestroy();
+    }
+
+    @Nullable
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
